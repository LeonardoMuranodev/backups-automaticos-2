ónica</h1>\n</header>\n\n<table class=\"company-info\">\n  <tr>\n    <td><strong>Empresa:</strong> Empresa123</td>\n    <td><strong>CUIT:</strong> 20409378472</td>\n  </tr>\n  <tr>\n    <td><strong>Dirección:</strong> AV Siempre Viva</td>\n    <td><strong>Teléfono:</strong> 11 1234-5678</td>\n  </tr>\n</table>\n\n<table class=\"client-info\">\n  <tr>\n    <td><strong>Cliente:</strong> {{ $('Obtener factura1').first().json.razon_social }}</td>\n    <td><strong>CUIT/DNI:</strong> {{ $('Obtener factura1').first().json.cuit_cliente }}</td>\n  </tr>\n  <tr>\n    <td><strong>Dirección:</strong> {{  $('Obtener factura1').first().json['cliente-dir'] }}</td>\n    <td><strong>Fecha:</strong>{{ $('Obtener factura1').first().json.fecha }}</td>\n  </tr>\n</table>\n\n<table>\n  <thead>\n    <tr>\n      <th>Descripción</th>\n      <th>Cantidad</th>\n      <th>Precio Unitario</th>\n      <th>Total</th>\n    </tr>\n  </thead>\n  <tbody>\n    {{ $json.filasHTML }}\n  </tbody>\n  <tfoot>\n    <tr>\n      <td colspan=\"3\">Subtotal</td>\n      <td>{{ $('Guardar Datos').first().json.imp_neto }}</td>\n    </tr>\n    <tr>\n      <td colspan=\"3\">IVA Total</td>\n      <td>{{ $('Guardar Datos').first().json.imp_iva }}</td>\n    </tr>\n    <tr>\n      <td colspan=\"3\">Total</td>\n      <td>{{ $('Guardar Datos').first().json.imp_total }}</td>\n    </tr>\n  </tfoot>\n</table>\n\n<div class=\"qr-code\">\n  <p>Escanea el QR para verificar la factura:</p>\n  <img src=\"https://api.qrserver.com/v1/create-qr-code/?size=350x350&data={{ $('QR-factura1').first().json.qr_code_text }}\" alt=\"QR Code\">\n\n</div>\n\n</body>\n</html>"},"type":"n8n-nodes-base.html","typeVersion":1.2,"position":[0,1248],"id":"ac284903-f53b-4c14-bf94-9ffe79de6124","name":"HTML1"},{"parameters":{"method":"POST","url":"https://app.afipsdk.com/api/v1/pdfs","authentication":"genericCredentialType","genericAuthType":"httpBearerAuth","sendBody":true,"bodyParameters":{"parameters":[{"name":"html","value":"={{ $json.html }}"},{"n